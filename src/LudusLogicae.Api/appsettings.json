{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=ludus_logicae;Username=postgres;Password=postgres"
  },
  "HealthChecks": {
    "Path": "/health-check"
  },
  "Database": {
    "AutoMigrate": true,
    "MigrationRetrySeconds": 60
  },
  "Llm": {
    "Providers": [
      {
        "Name": "OpenAI",
        "SupportedModels": [
          "gpt-4.1",
          "gpt-4.1-mini",
          "gpt-4.1-nano",
          "gpt-5",
          "gpt-5-mini",
          "gpt-5-nano"
        ]
      }
    ]
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "OrganizationId": "",
    "DefaultModel": "gpt-4.1-mini",
    "TimeoutSeconds": 300,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 250
  }
}
