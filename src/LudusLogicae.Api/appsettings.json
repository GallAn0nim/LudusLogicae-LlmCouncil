{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ludus_logicae;Username=postgres;Password=postgres"
  },
  "HealthChecks": {
    "Path": "/health-check"
  },
  "Database": {
    "AutoMigrate": true,
    "MigrationRetrySeconds": 60
  },
  "Llm": {
    "DefaultProvider": "Anthropic",
    "Providers": [
      {
        "Name": "OpenAI",
        "DefaultModel": "gpt-5",
        "SupportedModels": [
          "gpt-5",
          "gpt-5-mini",
          "gpt-5-nano"
        ]
      },
      {
        "Name": "Anthropic",
        "DefaultModel": "claude-sonnet-5-5",
        "SupportedModels": [
          "claude-haiku-5-5",
          "claude-sonnet-5-5",
          "claude-opus-5-5"
        ]
      }
    ]
  },
  "Anthropic": {
    "ApiKey": "",
    "TimeoutSeconds": 300,
    "MaxRetries": 3
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "OrganizationId": "",
    "DefaultModel": "gpt-5",
    "TimeoutSeconds": 300,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 250
  }
}
