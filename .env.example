# Copy this file to .env and adjust values as needed

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ludus_logicae
POSTGRES_PORT=5432

# API
API_HTTP_PORT=8080
API_HTTPS_PORT=8443
ASPNETCORE_ENVIRONMENT=Development

# Database Migration
DB_AUTO_MIGRATE=true
DB_MIGRATION_RETRY_SECONDS=60

# LLM provider used when a request has none (must be in Llm:Providers)
LLM_DEFAULT_PROVIDER=Anthropic

# Anthropic Configuration (default provider; default model claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# OpenAI Configuration (optional: leave OPENAI_API_KEY empty to run without OpenAI;
# CRUD works, AI calls return "provider not configured")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_DELAY_MS=250
